# ── Sunucu ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# Uygulamanın dış dünyadan görünen adresi.
# Stripe, ödeme sonrası kullanıcıyı buraya geri gönderir.
PUBLIC_URL=https://meetapp.example.com

# Oturum çerezlerini imzalar. Üretimde mutlaka uzun ve rastgele olmalı.
SESSION_SECRET=uzun-rastgele-bir-dize-buraya

# ── Uygulama sahibi ──────────────────────────────────────────────────────────
# Tüm katılım ücretleri bu hesapta toplanır.
OWNER_NAME=MeetApp
OWNER_EMAIL=owner@meetapp.app
OWNER_PASSWORD=owner1234

# ── Dil ──────────────────────────────────────────────────────────────────────
# Sunucu mesajlarının varsayılan dili (tr | en). Kullanıcı arayüzden başka bir
# dil seçerse istemci bunu X-Lang başlığıyla gönderir ve seçim öne geçer.
DEFAULT_LANG=tr

# ── Para ─────────────────────────────────────────────────────────────────────
# Ülkene göre değiştir. Örnekler:
#   Çekya  → CURRENCY=CZK  CURRENCY_SYMBOL=Kč
#   Euro   → CURRENCY=EUR  CURRENCY_SYMBOL=€
CURRENCY=TRY
CURRENCY_SYMBOL=₺

# Uygulama sahibinin payı (0–1). 0.10 = %10 komisyon,
# kalan %90 organizatöre ödenecek tutar olarak raporlanır.
COMMISSION_RATE=0.10

# ── Ödeme ────────────────────────────────────────────────────────────────────
# Bu anahtar tanımlıysa gerçek Stripe Checkout kullanılır ve para
# doğrudan bu anahtarın ait olduğu (uygulama sahibinin) hesabına geçer.
# Boş bırakılırsa uygulama demo kart ekranıyla çalışır.
# STRIPE_SECRET_KEY=sk_live_...

# ── Veritabanı ───────────────────────────────────────────────────────────────
# Veritabanı VE oturum dosyaları bu yolun bulunduğu klasöre yazılır.
# Sunucuda bu klasör kalıcı diske (volume) bağlı olmalıdır; yoksa her
# dağıtımda etkinlikler, kayıtlar ve oturumlar silinir.
# Varsayılan: ./meetapp.db   ·   Docker imajında: /data/meetapp.db
# DB_PATH=/data/meetapp.db
